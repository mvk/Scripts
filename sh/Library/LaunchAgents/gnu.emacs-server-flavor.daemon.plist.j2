<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
{%- for key in data %}
    <key>{{ key }}</key>
    {%- if data[key].type == "array" %}
    <array>
{%- for item in data[key].value %}
      <string>{{ item }}</string>
{%- endfor %}
    </array>
    {%- elif data[key].type == "string" %}
    <string>{{ data[key].value }}</string>
    {%- elif data[key].type == "bool" %}
    <{%- if data[key].value %}true{%- else %}false{%- endif %}/>
    {%- endif %}
{%- endfor %}
</dict>
</plist>
