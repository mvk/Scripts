;;; $DOOMDIR/init.el -*- lexical-binding: t; -*-

;; This file controls what Doom modules are enabled and what order they load
;; in. Remember to run 'doom sync' after modifying it!

;; NOTE: Press 'SPC h d h' (or 'C-h d h' for non-vim users) to access Doom's
;;   documentation. There you'll find a link to Doom's Module Index where all of
;;   our modules are listed, including what flags they support.

;; NOTE: Move your cursor over a module's name (or its flags) and press 'K' (or
;;   'C-c c k' for non-vim users) to view its documentation. This works on flags
;;   as well (those symbols that start with a plus).
;;
;;   Alternatively, press 'gd' (or 'C-c c d') on a module to browse its
;;   directory (for easy access to its source code).

(doom!  {% for section in doom_init -%}
{{ (":" ~ section) if loop.first else (("\n        :" ~ section) if loop.index0 == 1 else ("\n\n        :" ~ section)) -}}
{% for pkg in doom_init[section] -%}
{% set entry %}{% if pkg.condition | default("") | length %}(:{{ pkg.condition }} {% endif %}{% if pkg.extras | default([]) | length %}({% endif %}{{ pkg.name }}{% for extra in pkg.extras | default([]) %} +{{ extra }}{% endfor %}{% if pkg.extras | default([]) | length %}){% endif %}{% if pkg.condition | default("") | length %}){% endif %}{% endset -%}
{{ "\n        " ~ entry -}}
{% if pkg.comment | default("") | length %}{{ (" " * (comment_start_column - 8 - (entry | length))) ~ ";; " ~ pkg.comment }}{% endif -%}
{% endfor -%}
{% endfor -%})
