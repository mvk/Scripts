default partial alphanumeric_keys
xkb_symbols "basic" {
    name[Group1]= "Hebrew (Paleo)";

    // --- Top Row: Numbers & Shift Numerals ---
    key <AE01> { [ 1, 0x10010916 ] }; // Pressing Shift+1 outputs Num 1 (𐤖)
    key <AE02> { [ 2, 0x1001091A ] }; // Pressing Shift+2 outputs Num 2 (𐤚)
    key <AE03> { [ 3, 0x1001091B ] }; // Pressing Shift+3 outputs Num 3 (𐤛)
    key <AE04> { [ 4, 0x10010917 ] }; // Pressing Shift+4 outputs Num 10 (𐤗)
    key <AE05> { [ 5, 0x10010918 ] }; // Pressing Shift+5 outputs Num 20 (𐤘)
    key <AE06> { [ 6, 0x10010919 ] }; // Pressing Shift+6 outputs Num 100 (𐤙)

    // --- Letter Row 1 (QWERTY top row equivalents) ---
    key <AD01> { [ slash  ] }; // /
    key <AD02> { [ 0x1001091F ] }; // ' -> Word Separator (𐤟)
    key <AD03> { [ 0x10010912 ] }; // ק -> Qoph (𐤒)
    key <AD04> { [ 0x10010913 ] }; // ר -> Resh (𐤓)
    key <AD05> { [ 0x10010900 ] }; // א -> Aleph (𐤀)
    key <AD06> { [ 0x10010908 ] }; // ט -> Tet (𐤈)
    key <AD07> { [ 0x10010905 ] }; // ו -> Waw (𐤅)
    key <AD08> { [ 0x1001090D ] }; // ן -> Nun (𐤍)
    key <AD09> { [ 0x1001090C ] }; // ם -> Mem (𐤌)
    key <AD10> { [ 0x10010910 ] }; // פ -> Pe (𐤐)

    // --- Letter Row 2 (QWERTY home row equivalents) ---
    key <AC01> { [ 0x10010914 ] }; // ש -> Shin (𐤔)
    key <AC02> { [ 0x10010903 ] }; // ד -> Dalet (𐤃)
    key <AC03> { [ 0x10010902 ] }; // ג -> Gimel (𐤂)
    key <AC04> { [ 0x1001090A ] }; // כ -> Kaph (𐤊)
    key <AC05> { [ 0x1001090F ] }; // ע -> Ayin (𐤏)
    key <AC06> { [ 0x10010909 ] }; // י -> Yod (𐤉)
    key <AC07> { [ 0x10010907 ] }; // ח -> Het (𐤇)
    key <AC08> { [ 0x1001090B ] }; // ל -> Lamed (𐤋)
    key <AC09> { [ 0x1001090A ] }; // ך -> Kaph (𐤊)
    key <AC10> { [ 0x10010910 ] }; // פ -> Pe (𐤐)

    // --- Letter Row 3 (QWERTY bottom row equivalents) ---
    key <AB01> { [ 0x10010906 ] }; // ז -> Zayin (𐤆)
    key <AB02> { [ 0x1001090E ] }; // ס -> Samekh (𐤎)
    key <AB03> { [ 0x10010901 ] }; // ב -> Bet (𐤁)
    key <AB04> { [ 0x10010904 ] }; // ה -> He (𐤄)
    key <AB05> { [ 0x1001090D ] }; // נ -> Nun (𐤍)
    key <AB06> { [ 0x1001090C ] }; // מ -> Mem (𐤌)
    key <AB07> { [ 0x10010911 ] }; // צ -> Tsadi (𐤑)
    key <AB08> { [ 0x10010915 ] }; // ת -> Taw (𐤕)
    key <AB09> { [ 0x10010911 ] }; // ץ -> Tsadi (𐤑)
    key <AB10> { [ period ] }; // .

    // --- Spacebar Shift Variant: Word Separator ---
    key <SPCE> { [ space, 0x1001091F ] }; // Space -> Shift: Word Separator Dot (𐤟)
};
